{
  "name": "dsh-fallback-models",
  "version": "1.0.0",
  "description": "Fallback models for DeepSeek Harness: a global failover chain and a per-Session override, with a settings page and a composer menu.",
  "type": "module",
  "license": "MIT",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json",
    "README.md",
    "README.zh.md",
    "INSTALL.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "fallback",
    "failover",
    "model-routing",
    "llm"
  ],
  "icon": "./icon.svg",
  "engines": {
    "node": ">=24.9.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "pack": "npm pack"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.19.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WaveBird/dsh-fallback-models.git"
  },
  "bugs": {
    "url": "https://github.com/WaveBird/dsh-fallback-models/issues"
  },
  "homepage": "https://github.com/WaveBird/dsh-fallback-models#readme",
  "author": {
    "name": "WaveBird",
    "url": "https://github.com/WaveBird"
  }
}
